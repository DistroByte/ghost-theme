{{!--
    in="primary_tag" keeps photography and blog posts from linking to each other.
    The wrapper takes .gh-canvas rather than the nav itself: .gh-canvas is Edge's page-width
    grid, and its column tracks would otherwise swallow the nav's own two-column grid.
--}}
<div class="gh-canvas">
<nav class="post-nav" aria-label="More posts">
    {{#prev_post in="primary_tag"}}
    <a class="post-nav-link post-nav-prev" href="{{url}}">
        {{#if feature_image}}<img class="post-nav-image" src="{{img_url feature_image size="s"}}" alt="" loading="lazy">{{/if}}
        <span class="post-nav-text">
            <span class="post-nav-label">&larr; Previous</span>
            <span class="post-nav-title">{{title}}</span>
        </span>
    </a>
    {{/prev_post}}
    {{#next_post in="primary_tag"}}
    <a class="post-nav-link post-nav-next" href="{{url}}">
        <span class="post-nav-text">
            <span class="post-nav-label">Next &rarr;</span>
            <span class="post-nav-title">{{title}}</span>
        </span>
        {{#if feature_image}}<img class="post-nav-image" src="{{img_url feature_image size="s"}}" alt="" loading="lazy">{{/if}}
    </a>
    {{/next_post}}
</nav>
</div>
